# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# development | production  (production activa validaciones estrictas)
APP_ENV=development

# mysql+pymysql://usuario:clave@host:3306/base
# Usa un usuario de MySQL con permisos solo sobre esta base (no root).
DATABASE_URL=mysql+pymysql://courrier_app:CAMBIAR@127.0.0.1:3306/courrier

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_HORAS=12

# Origenes del frontend separados por coma (obligatorio en produccion)
ORIGENES_PERMITIDOS=http://localhost:5173

# Rate limiting compartido entre workers (recomendado en produccion)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# Numero de proxies delante de la app (Nginx = 1, Cloudflare + Nginx = 2)
PROXY_SALTOS=0

# Swagger en /docs (por defecto apagado en produccion)
# DOCS_HABILITADOS=false

LOG_LEVEL=INFO

# ---- Reglas de negocio ----
MAX_INTENTOS_ENTREGA=3
MAX_PEDIDOS_POR_RUTA=40
# Rutas completadas sin liquidar en caja que puede acumular un repartidor
MAX_RUTAS_SIN_LIQUIDAR=1
EVIDENCIA_OBLIGATORIA=false
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15

# ---- Captcha (login y recuperacion de contrasena) ----
# Obligatorio en produccion; en desarrollo puedes poner false si te estorba.
CAPTCHA_HABILITADO=true
MINUTOS_CAPTCHA=5

# ---- Recuperacion de contrasena por correo ----
# Base del enlace que llega al correo (en produccion, https://app.tuempresa.pe)
URL_FRONTEND=http://localhost:5173
MINUTOS_RECUPERACION=30
# Servidor SMTP. Si SMTP_HOST queda vacio, en desarrollo el enlace se muestra
# en la consola del backend (en produccion no se envia nada).
# Gmail: smtp.gmail.com, puerto 587, starttls, y una "contrasena de aplicacion".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=Courrier Express <no-responder@tuempresa.pe>

# ---- Admision y cotizacion de envios ----
# Peso volumetrico = largo x ancho x alto (cm) / FACTOR_VOLUMETRICO (estandar: 5000)
FACTOR_VOLUMETRICO=5000
# Seguro: porcentaje del valor declarado que se suma al flete
SEGURO_PORCENTAJE=1.0
VALOR_DECLARADO_MAXIMO=20000
MAX_BULTOS_POR_ENVIO=20
# Hora local del negocio respecto a UTC (Peru = -5). Se usa para la fecha comprometida de entrega.
UTC_OFFSET_HORAS=-5

# ---- Entrega y recojo a domicilio ----
# Firma del receptor en el celular del repartidor (constancia de entrega)
FIRMA_OBLIGATORIA=true
# Intentos de PIN equivocados antes de bloquear la entrega (se desbloquea regenerando el PIN)
MAX_INTENTOS_PIN=5
# Cargo por recojo a domicilio: se suma una vez, al primer envio del recojo
RECARGO_RECOJO=0.00

# ---- Avisos al cliente (WhatsApp Cloud API de Meta) ----
# Sin token, los avisos salen solo por correo (si SMTP esta configurado).
AVISOS_HABILITADOS=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_IDIOMA=es
CODIGO_PAIS_TELEFONO=51

# ---- Facturacion electronica (Nubefact) ----
# Ruta y token de tu cuenta Nubefact (Configuracion -> API). Sin ellos NO se emite nada.
NUBEFACT_URL=
NUBEFACT_TOKEN=
SERIE_BOLETA=B001
SERIE_FACTURA=F001
IGV_PORCENTAJE=18
