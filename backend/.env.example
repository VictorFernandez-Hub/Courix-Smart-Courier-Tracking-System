# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# development | production  (production activa validaciones estrictas)
APP_ENV=development

# mysql+pymysql://usuario:clave@host:3306/base
# Usa un usuario de MySQL con permisos solo sobre esta base (no root).
DATABASE_URL=mysql+pymysql://courrier_app:CAMBIAR@127.0.0.1:3306/courrier

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_HORAS=12

# Origenes del frontend separados por coma (obligatorio en produccion)
ORIGENES_PERMITIDOS=http://localhost:5173

# Rate limiting compartido entre workers (recomendado en produccion)
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://

# Numero de proxies delante de la app (Nginx = 1, Cloudflare + Nginx = 2)
PROXY_SALTOS=0

# Swagger en /docs (por defecto apagado en produccion)
# DOCS_HABILITADOS=false

LOG_LEVEL=INFO

# ---- Reglas de negocio ----
MAX_INTENTOS_ENTREGA=3
MAX_PEDIDOS_POR_RUTA=40
# Rutas completadas sin liquidar en caja que puede acumular un repartidor
MAX_RUTAS_SIN_LIQUIDAR=1
EVIDENCIA_OBLIGATORIA=false
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO_LOGIN=15
